{
  "manifest_version": 2,
  "name": "Dot Agent",
  "description": "Lets Dot's on-device assistant read and act on pages you ask it to.",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": { "id": "agent@dothq.org" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["agent.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "<all_urls>"]
}
