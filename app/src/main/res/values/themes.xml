<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DotBrowser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dot_accent</item>
        <item name="colorPrimaryVariant">@color/dot_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/dot_accent</item>
        <item name="colorSecondaryVariant">@color/dot_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/dot_accent</item>
        <item name="colorControlActivated">@color/dot_accent</item>
        <item name="colorControlHighlight">@color/dot_ripple</item>
        <item name="android:colorBackground">@color/dot_bg</item>
        <item name="android:windowBackground">@color/dot_bg</item>
        <item name="android:textColorPrimary">@color/dot_text</item>
        <item name="android:textColorSecondary">@color/dot_text_secondary</item>
        <item name="android:textColorHint">@color/dot_text_tertiary</item>
        <item name="android:textColorHighlight">#40256EF5</item>
        <item name="android:statusBarColor">@color/dot_bg</item>
        <item name="android:navigationBarColor">@color/dot_bg</item>
        <item name="android:windowLightStatusBar">@bool/dot_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/dot_light_bars</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Dot.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Dot.Dialog</item>
    </style>

    <style name="Theme.DotBrowser.Launch">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="ThemeOverlay.Dot.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/dot_accent</item>
        <item name="colorSurface">@color/dot_surface</item>
        <item name="colorOnSurface">@color/dot_text</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Dot.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Dot.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Dot.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Dot.DialogButton.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Dot.DialogButton.Secondary</item>
    </style>

    <style name="ShapeAppearance.Dot.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Dot.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/dot_text</item>
    </style>

    <style name="Dot.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dot_accent</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Dot.DialogButton.Secondary">
        <item name="android:textColor">@color/dot_text_secondary</item>
    </style>
</resources>
